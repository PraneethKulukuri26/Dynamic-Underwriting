# ============================================
# AIDUS - AI-Driven Dynamic Underwriting System
# Environment Configuration
# ============================================

# === LLM Backend (Groq) ===
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# === External APIs ===
FINEXER_API_KEY=your_finexer_key
FINEXER_BASE_URL=https://api.finexer.com/v1
FINEXER_CALLBACK_URL=http://localhost:8000/api/v1/consent/callback

HIBP_API_KEY=your_hibp_key
HIBP_BASE_URL=https://haveibeenpwned.com/api/v3

DIGIVERIFIER_API_KEY=your_digiverifier_key
DIGIVERIFIER_BASE_URL=https://api.digiverifier.com/v1

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql+asyncpg://aidus:aidus_secret@postgres:5432/aidus_db
POSTGRES_USER=aidus
POSTGRES_PASSWORD=aidus_secret
POSTGRES_DB=aidus_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Privacy Configuration ===
DEFAULT_EPSILON=1.0
DEFAULT_DELTA=1e-5
MAX_PRIVACY_BUDGET=10.0
GRADIENT_CLIP_NORM=1.0

# === Application Mode ===
USE_MOCK_DATA=true
DEBUG=true
LOG_LEVEL=INFO

# === Server ===
APP_HOST=0.0.0.0
APP_PORT=8000
